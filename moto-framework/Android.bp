java_library {
    name: "moto-framework",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    installable: true,
    visibility: ["//visibility:public"],
}

prebuilt_etc {
    name: "moto-framework-roadstr-permissions",
    src: "permissions/moto-framework.xml",
    sub_dir: "permissions",
    filename: "moto-framework.xml",
}
