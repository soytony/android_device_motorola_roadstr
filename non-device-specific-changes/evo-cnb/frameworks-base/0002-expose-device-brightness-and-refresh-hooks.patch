+package android.hardware.display;
+
+import android.content.Context;
+import android.hardware.SensorManager;
+import android.os.Handler;
+
+/**
+ * Optional in-process device-specific ambient-lux processor.
+ *
+ * @hide
+ */
+public interface AmbientLuxProcessor {
+    /**
+     * Initializes the processor with opaque device configuration from the framework RRO.
+     * The framework deliberately does not interpret these values.
+     */
+    void initialize(Context context, SensorManager sensorManager, Handler handler,
+            String[] parameters);
+
+    /** Starts device-specific listeners while automatic brightness is active. */
+    void start();
+
+    /** Stops device-specific listeners while automatic brightness is inactive. */
+    void stop();
+
+    /**
+     * Records an auto-brightness target that the controller has accepted for the display.
+     *
+     * <p>The timestamp uses the same elapsed-realtime sensor-event time base supplied to
+     * {@link #process}. Implementations can use this as a generic delayed-output signal, for
+     * example to compensate sensor measurements affected by panel output.</p>
+     */
+    void onTargetNitsChanged(long timestampMillis, float targetNits);
+
+    /**
+     * Returns processed lux, or {@link Float#NaN} to use the primary sensor sample unchanged.
+     *
+     * <p>The primary sample is passed synchronously so an implementation does not need to create
+     * a second listener for the same sensor, whose callback ordering would be undefined.</p>
+     */
+    float process(long timestampMillis, float primaryLux, boolean dozing);
+
+    void reset();
+}
