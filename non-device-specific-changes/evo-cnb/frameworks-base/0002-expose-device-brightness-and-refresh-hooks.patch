 core/res/res/values/config.xml                |   8 ++
 core/res/res/values/symbols.xml               |   2 +
 .../AutomaticBrightnessController.java        | 109 ++++++++++++++++++
 .../display/mode/DisplayModeDirector.java     |   3 +-
 5 files changed, 170 insertions(+), 1 deletion(-)
 create mode 100644 core/java/android/hardware/display/AmbientLuxProcessor.java

