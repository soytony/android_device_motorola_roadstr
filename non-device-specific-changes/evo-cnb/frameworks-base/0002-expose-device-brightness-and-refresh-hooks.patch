+    private float getCurrentTargetNits() {
+        final float brightness = BrightnessUtils.isValidBrightnessValue(mScreenAutoBrightness)
+                ? mScreenAutoBrightness : mLastConfiguredBrightness;
+        if (!BrightnessUtils.isValidBrightnessValue(brightness)) {
+            return Float.NaN;
+        }
+        return mCurrentBrightnessMapper.convertToNits(brightness);
+    }
+
+    /** Records the controller's accepted target on the sensor-event time scale. */
+    private void notifyAmbientLuxProcessorTargetChanged() {
+        if (mAmbientLuxProcessor == null) {
+            return;
+        }
+        final float targetNits = getCurrentTargetNits();
+        if (!Float.isFinite(targetNits) || targetNits < 0) {
+            return;
+        }
+        try {
+            mAmbientLuxProcessor.onTargetNitsChanged(mClock.getSensorEventScaleTime(), targetNits);
+        } catch (Throwable t) {
+            disableAmbientLuxProcessor(t);
+        }
+    }
+
+    /** Disables only the optional provider so the standard primary-ALS path remains available. */
+    private void disableAmbientLuxProcessor(Throwable error) {
+        Slog.w(TAG, "Disabling failing ambient-lux processor", error);
+        try {
+            mAmbientLuxProcessor.stop();
+        } catch (Throwable stopError) {
+            Slog.w(TAG, "Ambient-lux processor failed while stopping", stopError);
+        }
+        mAmbientLuxProcessor = null;
+    }
+
     private void applyLightSensorMeasurement(long time, float lux) {
