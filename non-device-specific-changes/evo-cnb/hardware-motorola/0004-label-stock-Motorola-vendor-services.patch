diff --git a/sepolicy/qti/vendor/hal_moto_panel.te b/sepolicy/qti/vendor/hal_moto_panel.te
new file mode 100644
index 0000000..fa08fb7
--- /dev/null
+++ b/sepolicy/qti/vendor/hal_moto_panel.te
@@ -0,0 +1,15 @@
+type hal_moto_panel_default, domain;
+type hal_moto_panel_default_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(hal_moto_panel_default)
+binder_use(hal_moto_panel_default)
+vndbinder_use(hal_moto_panel_default)
+add_service(hal_moto_panel_default, hal_moto_panel_aidl_service)
+
+allow hal_moto_panel_default sysfs_dt_chosen:dir search;
+allow hal_moto_panel_default sysfs_dt_chosen:file { read open };
+allow hal_moto_panel_default graphics_device:chr_file { ioctl read write open };
+
+# The fingerprint HAL requests local HBM through the panel service.
+binder_call(hal_fingerprint_default, hal_moto_panel_default)
+allow hal_fingerprint_default hal_moto_panel_aidl_service:service_manager find;
