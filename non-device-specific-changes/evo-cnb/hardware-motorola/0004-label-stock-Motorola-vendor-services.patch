 type proc_sched_lib_mask_cpuinfo, fs_type, proc_type;
 
 # Powershare
 type vendor_sysfs_wlc, fs_type, sysfs_type;
+type sysfs_wls_dev, fs_type, sysfs_type;
+type touchRec_data_file, file_type, data_file_type;
 
 # Radio
 type vendor_persist_mdm_file, file_type, vendor_persist_type;
