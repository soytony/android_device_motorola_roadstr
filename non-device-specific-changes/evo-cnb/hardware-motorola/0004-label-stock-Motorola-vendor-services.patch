--- a/sepolicy/qti/vendor/file_contexts
+++ b/sepolicy/qti/vendor/file_contexts
@@ -124,6 +124,12 @@
 # Touch HAL
 /vendor/bin/hw/vendor\.lineage\.touch-service\.motorola    u:object_r:hal_lineage_touch_default_exec:s0
 
+# Motorola display and wireless HALs
+/vendor/bin/hw/com\.motorola\.hardware\.display\.panel-service       u:object_r:hal_moto_panel_default_exec:s0
+/vendor/bin/hw/com\.motorola\.hardware\.display\.touch-service       u:object_r:hal_mottouch_default_exec:s0
+/vendor/bin/hw/motorola\.hardware\.wireless\.wlc-service             u:object_r:hal_motwlc_default_exec:s0
+/data/vendor/touchrec(/.*)?                                          u:object_r:touchRec_data_file:s0
+
 # Touchscreen
 /sys/devices/platform/soc/a94000\.i2c/i2c-2/2-0049/double_click    u:object_r:vendor_sysfs_touchpanel:s0
 /sys/devices/platform/soc/a94000\.i2c/i2c-2/2-0049/single_click    u:object_r:vendor_sysfs_touchpanel:s0
@@ -143,3 +149,10 @@
 
 # Wakeup (Audio Service)
 /sys/devices/platform/soc/soc:qcom,msm-audio-apr/soc:qcom,msm-audio-apr:qcom,q6core-audio/soc:qcom,msm-audio-apr:qcom,q6core-audio:sound/Listen\s[0-9]+\sAudio\sService/wakeup/wakeup[0-9]+(/.*)?    u:object_r:sysfs_wakeup:s0
+
+# Battery health
+/(mnt/vendor/persist|persist)/batt_health(/.*)?    u:object_r:persist_batt_file:s0
+/(vendor|system/vendor)/bin/batt_health         u:object_r:batt_health_exec:s0
+
+# Dolby Codec2 service uses the platform mediacodec sandbox in stock policy.
+/vendor/bin/hw/vendor\.dolby\.media\.c2-default-service-dax    u:object_r:mediacodec_exec:s0
