From f28a91bc6df81bc43d6d456dbdb5cb044df58b25 Mon Sep 17 00:00:00 2001
From: tonyfan <waterwet@outlook.com>
Date: Sun, 18 Oct 2026 15:05:01 +0800
Subject: [PATCH] fix: label stock Motorola vendor services

Stock battery, panel, touch, wireless and Dolby services need dedicated
SELinux labels and scoped access. RoadSTR removes duplicate local labels.
These rules live in the inherited Motorola policy; review concrete paths
and service availability before reuse on another Motorola device.

Change-Id: I6bea79d17bfcaa468a9407550d1fd3bb3b71f6ee
---
 sepolicy/qti/private/property_contexts |  4 ++++
 sepolicy/qti/public/property.te        |  1 +
 sepolicy/qti/vendor/batt_health.te     | 19 +++++++++++++++++++
 sepolicy/qti/vendor/file.te            |  3 +++
 sepolicy/qti/vendor/file_contexts      | 13 +++++++++++++
 sepolicy/qti/vendor/genfs_contexts     | 18 ++++++++++++++++++
 sepolicy/qti/vendor/hal_moto_panel.te  | 15 +++++++++++++++
 sepolicy/qti/vendor/hal_mottouch.te    | 11 +++++++++++
 sepolicy/qti/vendor/hal_motwlc.te      | 11 +++++++++++
 sepolicy/qti/vendor/service.te         |  5 +++++
 10 files changed, 100 insertions(+)
 create mode 100644 sepolicy/qti/public/property.te
 create mode 100644 sepolicy/qti/vendor/batt_health.te
 create mode 100644 sepolicy/qti/vendor/hal_moto_panel.te
 create mode 100644 sepolicy/qti/vendor/hal_mottouch.te
 create mode 100644 sepolicy/qti/vendor/hal_motwlc.te

diff --git a/sepolicy/qti/private/property_contexts b/sepolicy/qti/private/property_contexts
index 51c6e8e..ec94a85 100644
--- a/sepolicy/qti/private/property_contexts
+++ b/sepolicy/qti/private/property_contexts
@@ -7,3 +7,7 @@ ro.camera.res.fmq.size            u:object_r:exported_camera_prop:s0
 
 # Motorola
 ro.mot.build.customerid    u:object_r:build_prop:s0 exact string
+
+# Battery lifetime information exported by the Motorola health daemon.
+ro.sys.battery.FirstUsageDate    u:object_r:moto_battinfo_prop:s0 exact string
+sys.clear_batt_first_usage_date  u:object_r:moto_battinfo_prop:s0 exact bool
diff --git a/sepolicy/qti/public/property.te b/sepolicy/qti/public/property.te
new file mode 100644
index 0000000..3c61bb5
--- /dev/null
+++ b/sepolicy/qti/public/property.te
@@ -0,0 +1 @@
+system_public_prop(moto_battinfo_prop)
diff --git a/sepolicy/qti/vendor/batt_health.te b/sepolicy/qti/vendor/batt_health.te
new file mode 100644
index 0000000..c306451
--- /dev/null
+++ b/sepolicy/qti/vendor/batt_health.te
@@ -0,0 +1,19 @@
+type batt_health, domain;
+type batt_health_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(batt_health)
+
+# Monitor power-supply uevents used to maintain battery lifetime metadata.
+allow batt_health self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
+
+# Read the power-supply class and update the battery driver's lifetime fields.
+allow batt_health sysfs:dir r_dir_perms;
+allow batt_health vendor_sysfs_battery_supply:dir r_dir_perms;
+allow batt_health vendor_sysfs_battery_supply:{ file lnk_file } rw_file_perms;
+
+# Keep the persistent lifetime counters in the device-specific persist area.
+allow batt_health mnt_vendor_file:dir search;
+allow batt_health persist_batt_file:dir create_dir_perms;
+allow batt_health persist_batt_file:file create_file_perms;
+
+get_prop(batt_health, moto_battinfo_prop)
