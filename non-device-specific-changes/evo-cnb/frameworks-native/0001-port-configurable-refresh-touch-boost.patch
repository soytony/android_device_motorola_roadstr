From 476adf1bf512720907551b6a24246b1bbb0daa77 Mon Sep 17 00:00:00 2001
From: tonyfan <waterwet@outlook.com>
Date: Sun, 18 Oct 2026 15:05:01 +0800
Subject: [PATCH] fix: port configurable refresh touch boost

Allow cross-group touch boost with a device-controlled cap. Pair with
RoadSTR SurfaceFlinger properties and refresh overlays; review policy
impact before enabling on other display stacks.
---
 .../Scheduler/RefreshRateSelector.cpp         | 32 +++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/services/surfaceflinger/Scheduler/RefreshRateSelector.cpp b/services/surfaceflinger/Scheduler/RefreshRateSelector.cpp
index 28a23c19e5..09d8c78b1f 100644
--- a/services/surfaceflinger/Scheduler/RefreshRateSelector.cpp
+++ b/services/surfaceflinger/Scheduler/RefreshRateSelector.cpp
@@ -778,11 +778,34 @@ auto RefreshRateSelector::getRankedFrameRatesLocked(const std::vector<LayerRequi
     const auto anchorGroup =
             seamedFocusedLayers > 0 ? activeMode.getGroup() : defaultMode->getGroup();
 
+    // Some panels expose their low-power mode in a separate config group. Normally a touch
+    // boost stays in the default group to avoid a non-seamless switch. Products that explicitly
+    // opt in can use their already-allowed cross-group switch to reach the high refresh mode.
+    const auto touchBoostAnchorGroup =
+            policy->allowGroupSwitching &&
+                    base::GetBoolProperty("ro.surface_flinger.touch_boost_across_groups", false)
+            ? std::optional<int>{}
+            : std::optional<int>{anchorGroup};
+
+    // A value of zero preserves the existing unconstrained touch-boost policy. Products with a
+    // panel-specific luminance discontinuity between modes can cap only the transient boost,
+    // while explicit layer votes continue to select their requested refresh rate.
+    const int touchBoostRefreshRate =
+            base::GetIntProperty("ro.surface_flinger.touch_boost_refresh_rate", 0);
+    const auto touchBoostPredicate = [touchBoostRefreshRate](const FrameRateMode& frameRateMode) {
+        return touchBoostRefreshRate <= 0 ||
+                frameRateMode.fps.getValue() <= static_cast<float>(touchBoostRefreshRate);
+    };
+
     // Consider the touch event if there are no Explicit* layers. Otherwise wait until after we've
     // selected a refresh rate to see if we should apply touch boost.
     if (signals.touch && !hasExplicitVoteLayers) {
         ALOGV("Touch Boost");
-        const auto ranking = rankFrameRates(anchorGroup, RefreshRateOrder::Descending);
+        auto ranking = rankFrameRates(touchBoostAnchorGroup, RefreshRateOrder::Descending,
+                                      std::nullopt, touchBoostPredicate);
+        if (ranking.empty()) {
+            ranking = rankFrameRates(touchBoostAnchorGroup, RefreshRateOrder::Descending);
+        }
         SFTRACE_FORMAT_INSTANT("%s (Touch Boost)",
                                to_string(ranking.front().frameRateMode.fps).c_str());
         return {ranking, GlobalSignals{.touch = true}};
@@ -1075,7 +1098,12 @@ auto RefreshRateSelector::getRankedFrameRatesLocked(const std::vector<LayerRequi
     const bool isLateGlobalTouchBoost = signals.touch && explicitDefaultVoteLayers == 0;
     const bool isLateTouchBoost = isLateGlobalTouchBoost || isAppTouchBoost;
     if (isLateTouchBoost && isTouchBoostForExplicitExact() && isTouchBoostForCategory()) {
-        const auto touchRefreshRates = rankFrameRates(anchorGroup, RefreshRateOrder::Descending);
+        auto touchRefreshRates = rankFrameRates(touchBoostAnchorGroup, RefreshRateOrder::Descending,
+                                                std::nullopt, touchBoostPredicate);
+        if (touchRefreshRates.empty()) {
+            touchRefreshRates = rankFrameRates(touchBoostAnchorGroup,
+                                                RefreshRateOrder::Descending);
+        }
         using fps_approx_ops::operator<;
 
         if (scores.front().frameRateMode.fps <= touchRefreshRates.front().frameRateMode.fps) {
-- 
