+            break;
         case Tag::halReservedExit:
             if (const int32_t cookie = command.get<Tag::halReservedExit>();
                 cookie == mContext->getInternalCommandCookie()) {
@@ -839,6 +847,43 @@ ndk::ScopedAStatus StreamCommonImpl::removeEffect(
