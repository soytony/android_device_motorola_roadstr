+        RETURN_STATUS_IF_ERROR(stream->setMmapBufferDescriptor(mmapRef));
         _aidl_return->desc.bufferSizeFrames = bufferSizeFrames;
     }
 
@@ -926,6 +929,9 @@ ndk::ScopedAStatus Module::openOutputStream(const OpenOutputStreamArguments& in_
         mmapRef.sharedMemory.fd = ndk::ScopedFileDescriptor{fd};
         mmapRef.burstSizeFrames = burstSizeFrames;
         mmapRef.flags = mmapFlags;
+        mmapRef.sharedMemory.size =
+                static_cast<int64_t>(bufferSizeFrames) * stream->getContext().getFrameSize();
+        RETURN_STATUS_IF_ERROR(stream->setMmapBufferDescriptor(mmapRef));
         _aidl_return->desc.bufferSizeFrames = bufferSizeFrames;
     } else if (mTelephony && hasOutputVoipRxFlag(port->flags)) {
         // TODO remove this way of handling streams for telephony
@@ -1614,6 +1620,12 @@ ndk::ScopedAStatus Module::getAAudioHardwareBurstMinUsec(int32_t* _aidl_return)
     return ndk::ScopedAStatus::ok();
 }
 
+ndk::ScopedAStatus Module::getFlushFromFrameSupport(
