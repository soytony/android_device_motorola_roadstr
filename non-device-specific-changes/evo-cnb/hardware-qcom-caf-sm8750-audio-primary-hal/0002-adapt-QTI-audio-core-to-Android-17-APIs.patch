 hal/core/Stream.cpp                           | 49 +++++++++++++++++++
 hal/core/include/qti-audio-core/Module.h      |  3 ++
 hal/core/include/qti-audio-core/Stream.h      | 21 ++++++++
 hal/core/utils/include/qti-audio-core/Utils.h |  5 ++
 5 files changed, 91 insertions(+), 1 deletion(-)

