 }
 
+ndk::ScopedAStatus StreamCommonImpl::setMmapBufferDescriptor(
+        const ::aidl::android::hardware::audio::core::MmapBufferDescriptor& descriptor) {
+    std::lock_guard lock(mMmapBufferMutex);
+    ::aidl::android::hardware::audio::core::MmapBufferDescriptor copy;
+    copy.sharedMemory.fd = descriptor.sharedMemory.fd.dup();
+    if (copy.sharedMemory.fd.get() < 0) {
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+    }
+    copy.sharedMemory.size = descriptor.sharedMemory.size;
+    copy.burstSizeFrames = descriptor.burstSizeFrames;
+    copy.flags = descriptor.flags;
+    mMmapBufferDescriptor = std::move(copy);
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus StreamCommonImpl::createMmapBuffer(
+        ::aidl::android::hardware::audio::core::MmapBufferDescriptor* descriptor) {
+    std::lock_guard lock(mMmapBufferMutex);
+    if (isClosed()) {
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+    }
+    if (!hasMMapFlagsEnabled(mContextRef.getFlags())) {
+        return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+    }
+    if (mWorker->getState() == StreamDescriptor::State::STANDBY || !mMmapBufferDescriptor) {
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+    }
+    descriptor->sharedMemory.fd = mMmapBufferDescriptor->sharedMemory.fd.dup();
+    if (descriptor->sharedMemory.fd.get() < 0) {
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+    }
+    descriptor->sharedMemory.size = mMmapBufferDescriptor->sharedMemory.size;
+    descriptor->burstSizeFrames = mMmapBufferDescriptor->burstSizeFrames;
+    descriptor->flags = mMmapBufferDescriptor->flags;
+    return ndk::ScopedAStatus::ok();
+}
+
 ndk::ScopedAStatus StreamCommonImpl::close() {
     ModulePrimary::outListMutex.lock();
     LOG(DEBUG) << __func__;
@@ -846,6 +891,10 @@ ndk::ScopedAStatus StreamCommonImpl::close() {
         stopAndJoinWorker();
         onClose();
         mWorker->setClosed();
+        {
+            std::lock_guard lock(mMmapBufferMutex);
+            mMmapBufferDescriptor.reset();
+        }
         ModulePrimary::outListMutex.unlock();
         return ndk::ScopedAStatus::ok();
     } else {
