From e4d7b03a2053ad58d943915fe7dcb57cad1fce64 Mon Sep 17 00:00:00 2001
From: tonyfan <waterwet@outlook.com>
Date: Sun, 18 Oct 2026 15:05:02 +0800
Subject: [PATCH] fix: correct PAL logging formats and types

Android 17 compiler checks reject mismatched format arguments.
Correct the logging calls while retaining -Werror.

Change-Id: I421c31c6ce7732f18ffd03276cff12d4f7a9f249
---
 device/src/Bluetooth.cpp                 | 4 ++--
 device/src/HapticsDevProtection.cpp      | 2 +-
 resource_manager/src/ResourceManager.cpp | 8 ++++----
 session/src/Session.cpp                  | 2 +-
 session/src/SessionAlsaPcm.cpp           | 4 ++--
 session/src/SessionAlsaUtils.cpp         | 2 +-
 session/src/SoundTriggerEngineGsl.cpp    | 6 +++---
 stream/src/StreamHaptics.cpp             | 4 ++--
 8 files changed, 16 insertions(+), 16 deletions(-)

diff --git a/device/src/Bluetooth.cpp b/device/src/Bluetooth.cpp
index c811e4697..fc5261357 100644
--- a/device/src/Bluetooth.cpp
+++ b/device/src/Bluetooth.cpp
@@ -2569,9 +2569,9 @@ void BtSco::convertCodecInfo(audio_lc3_codec_cfg_t &lc3CodecInfo,
         streamMapStr = match.suffix().str();
     }
 
-    PAL_DBG(LOG_TAG, "stream map out size: %d, stream map in size: %d", steamMapOut.size(), steamMapIn.size());
+    PAL_DBG(LOG_TAG, "stream map out size: %zu, stream map in size: %zu", steamMapOut.size(), steamMapIn.size());
     if ((steamMapOut.size() == 0) || (steamMapIn.size() == 0)) {
-        PAL_ERR(LOG_TAG, "invalid size steamMapOut.size %d, steamMapIn.size %d",
+        PAL_ERR(LOG_TAG, "invalid size steamMapOut.size %zu, steamMapIn.size %zu",
                 steamMapOut.size(), steamMapIn.size());
         return;
     }
