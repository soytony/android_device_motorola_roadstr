@@ -14925,7 +14925,7 @@ void ResourceManager::reconfigureScoStreams() {
         dattr = nullptr;
     }
 
-    PAL_DBG(LOG_TAG, "streamDevDisconnect size=%d and streamDevConnect size=%d",
