From a74a5ce22d6b93ff2ae1dea5734fbef76a60f60d Mon Sep 17 00:00:00 2001
From: tonyfan <waterwet@outlook.com>
Date: Tue, 14 Jul 2026 15:29:55 +0800
Subject: [PATCH] SystemUI: add optional UDFPS HBM service

---
 packages/SystemUI/Android.bp                  |  2 +
 packages/SystemUI/res/values/config.xml       |  3 +
 .../systemui/biometrics/AuthController.java   |  2 +-
 .../systemui/biometrics/UdfpsDisplayMode.kt   | 65 +++++++++++++++++--
 4 files changed, 66 insertions(+), 6 deletions(-)

diff --git a/packages/SystemUI/Android.bp b/packages/SystemUI/Android.bp
index b41566be77c7972a74a8119bde88e6adec2cf70f..0387dd16dc7a592902ac2767c2582a1456081e3e 100644
--- a/packages/SystemUI/Android.bp
+++ b/packages/SystemUI/Android.bp
@@ -592,6 +592,7 @@ android_library {
         "displaylib",
         "aconfig_settings_flags_lib",
         "vendor.lineage.powershare-V1-java",
+        "vendor.lineage.biometrics.udfps-V1-java",
     ],
     javacflags: [
         "-Aroom.schemaLocation=frameworks/base/packages/SystemUI/schemas",
@@ -810,6 +811,7 @@ android_library {
         "kairos",
         "displaylib",
         "vendor.lineage.powershare-V1-java",
+        "vendor.lineage.biometrics.udfps-V1-java",
     ],
 }
 
diff --git a/packages/SystemUI/res/values/config.xml b/packages/SystemUI/res/values/config.xml
index e0bc1ec0e01ae125ce255d29a61a1d6a080f61ba..994d0bac050690843222ed69310a1a5ba6837182 100644
--- a/packages/SystemUI/res/values/config.xml
+++ b/packages/SystemUI/res/values/config.xml
@@ -722,6 +722,9 @@
          when the device supports an under-display fingerprint sensor -->
     <integer name="config_udfpsDeviceEntryIconLongPress" translatable="false">100</integer>
 
+    <!-- Optional stable Binder service that controls optical UDFPS local HBM. -->
+    <string name="config_udfpsHbmService" translatable="false"></string>
+
     <!-- package name of a built-in camera app to use to restrict implicit intent resolution
          when the double-press power gesture is used. Ignored if empty. -->
     <string translatable="false" name="config_cameraGesturePackage"></string>
diff --git a/packages/SystemUI/src/com/android/systemui/biometrics/AuthController.java b/packages/SystemUI/src/com/android/systemui/biometrics/AuthController.java
index 201c80537675fb301ee02652c9153f74f2ce968b..d4d22e86474f49395ad0b661d662b64b31bf36f7 100644
--- a/packages/SystemUI/src/com/android/systemui/biometrics/AuthController.java
+++ b/packages/SystemUI/src/com/android/systemui/biometrics/AuthController.java
@@ -320,7 +320,7 @@ public class AuthController implements
             });
             mUdfpsController.setAuthControllerUpdateUdfpsLocation(this::updateUdfpsLocation);
             mUdfpsController.setUdfpsDisplayMode(new UdfpsDisplayMode(mContext, mExecution,
-                    this, mUdfpsLogger.get()));
+                    this, mUdfpsLogger.get(), mBackgroundExecutor));
             mUdfpsBounds = mUdfpsProps.get(0).getLocation().getRect();
         }
         mSidefpsProps = !sidefpsProps.isEmpty() ? sidefpsProps : null;
diff --git a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsDisplayMode.kt b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsDisplayMode.kt
index 670a8e6389aff85fb6cfd48d85201185d7fe9e37..56326b1778dd5da86a2f7b5b272ef4ddc0a006cc 100644
--- a/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsDisplayMode.kt
+++ b/packages/SystemUI/src/com/android/systemui/biometrics/UdfpsDisplayMode.kt
@@ -18,8 +18,12 @@ package com.android.systemui.biometrics
 
 import android.content.Context
 import android.os.RemoteException
+import android.os.ServiceManager
 import android.os.Trace
+import com.android.systemui.res.R
 import com.android.systemui.util.concurrency.Execution
+import java.util.concurrent.Executor
+import vendor.lineage.biometrics.udfps.IUdfpsHbm
 
 private const val TAG = "UdfpsDisplayMode"
 
@@ -32,11 +36,14 @@ constructor(
     private val context: Context,
     private val execution: Execution,
     private val authController: AuthController,
-    private val logger: UdfpsLogger
+    private val logger: UdfpsLogger,
+    private val backgroundExecutor: Executor
 ) : UdfpsDisplayModeProvider {
 
     // The request is reset to null after it's processed.
     private var currentRequest: Request? = null
+    private var requestGeneration = 0L
+    private val hbmServiceName = context.getString(R.string.config_udfpsHbmService)
 
     override fun enable(onEnabled: Runnable?) {
         execution.isMainThread()
@@ -54,7 +61,7 @@ constructor(
         Trace.beginSection("UdfpsDisplayMode.enable")
 
         // Track this request in one object.
-        val request = Request(context.displayId)
+        val request = Request(context.displayId, ++requestGeneration)
         currentRequest = request
 
         try {
@@ -66,7 +73,27 @@ constructor(
             logger.e(TAG, "enable", e)
         }
 
-        onEnabled?.run() ?: logger.w(TAG, "enable | onEnabled is null")
+        if (hbmServiceName.isEmpty()) {
+            onEnabled?.run() ?: logger.w(TAG, "enable | onEnabled is null")
+        } else {
+            backgroundExecutor.execute {
+                val enabled = setHbmEnabled(true)
+                context.mainExecutor.execute main@{
+                    if (currentRequest?.generation != request.generation) {
+                        if (enabled) {
+                            backgroundExecutor.execute { setHbmEnabled(false) }
+                        }
+                        return@main
+                    }
+                    if (enabled) {
+                        logger.v(TAG, "enable | local HBM enabled")
+                        onEnabled?.run() ?: logger.w(TAG, "enable | onEnabled is null")
+                    } else {
+                        logger.e(TAG, "enable | failed to enable local HBM")
+                    }
+                }
+            }
+        }
         Trace.endSection()
     }
 
@@ -91,10 +118,38 @@ constructor(
         }
 
         currentRequest = null
-        onDisabled?.run() ?: logger.w(TAG, "disable | onDisabled is null")
+        requestGeneration++
+        if (hbmServiceName.isEmpty()) {
+            onDisabled?.run() ?: logger.w(TAG, "disable | onDisabled is null")
+        } else {
+            backgroundExecutor.execute {
+                setHbmEnabled(false)
+                context.mainExecutor.execute {
+                    onDisabled?.run() ?: logger.w(TAG, "disable | onDisabled is null")
+                }
+            }
+        }
         Trace.endSection()
     }
+
+    private fun setHbmEnabled(enabled: Boolean): Boolean {
+        return try {
+            val binder = ServiceManager.getService(hbmServiceName)
+            if (binder == null) {
+                logger.e(TAG, "setHbmEnabled | service unavailable: $hbmServiceName")
+                false
+            } else {
+                IUdfpsHbm.Stub.asInterface(binder).setEnabled(enabled)
+            }
+        } catch (e: RemoteException) {
+            logger.e(TAG, "setHbmEnabled | remote failure", e)
+            false
+        } catch (e: RuntimeException) {
+            logger.e(TAG, "setHbmEnabled | service failure", e)
+            false
+        }
+    }
 }
 
 /** Tracks a request to enable the UDFPS mode. */
-private data class Request(val displayId: Int)
+private data class Request(val displayId: Int, val generation: Long)
-- 
2.34.1

