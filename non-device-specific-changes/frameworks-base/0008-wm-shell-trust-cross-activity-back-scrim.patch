From 57a58aeb95756bd2d1f6d293e1ce8f8792a07108 Mon Sep 17 00:00:00 2001
From: tonyfan <waterwet@outlook.com>
Date: Sat, 18 Jul 2026 12:12:07 +0800
Subject: [PATCH] WM Shell: trust cross-activity back scrim

---
 .../com/android/wm/shell/back/CrossActivityBackAnimation.kt    | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/back/CrossActivityBackAnimation.kt b/libs/WindowManager/Shell/src/com/android/wm/shell/back/CrossActivityBackAnimation.kt
index 102ebe8be9a1fc21c368e1d0e8aa0eb1f3dac86d..425d165ff79fb16366927006319d7338a8be45d5 100644
--- a/libs/WindowManager/Shell/src/com/android/wm/shell/back/CrossActivityBackAnimation.kt
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/back/CrossActivityBackAnimation.kt
@@ -423,6 +423,9 @@ abstract class CrossActivityBackAnimation(
             .setAlpha(scrimLayer!!, maxScrimAlpha)
             .setCrop(scrimLayer!!, scrimCrop)
             .setRelativeLayer(scrimLayer!!, closingTarget!!.leash, -1)
+            // This system-owned surface has no input channel. Do not let it invalidate touches
+            // sent to the visible activity while the post-commit animation is running.
+            .setTrustedOverlay(scrimLayer!!, true)
             .show(scrimLayer)
     }
 
