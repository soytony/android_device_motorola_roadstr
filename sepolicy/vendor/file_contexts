# Device-specific labels for vendor daemons.
# Use the existing Qualcomm/Motorola face-HAL domain. It includes access to
# Tetras' camera properties and persistent enrollment data.
/vendor/bin/hw/android\.hardware\.biometrics\.face-service\.face-isv u:object_r:vendor_biometricsface_exec:s0

/data/vendor/tetras_data(/.*)? u:object_r:vendor_biometricsface_data_file:s0

/vendor/bin/roadstr-udfps-hbm          u:object_r:hal_fingerprint_default_exec:s0

# Motorola boot scripts need dedicated domains.  Without these labels init
# executes them directly and inherits their vendor-specific access requests.
/vendor/bin/init\.mmi\.usb\.sh                    u:object_r:init_usb_exec:s0
/vendor/bin/init\.mmi\.wls\.sh                    u:object_r:init_wls_exec:s0
/vendor/bin/init\.mmi\.cap\.sh                    u:object_r:init_capsensor_exec:s0
/vendor/bin/init\.mmi\.display\.sh                u:object_r:init_display_exec:s0
/vendor/bin/init\.mmi\.block_perm\.sh             u:object_r:init_block_perm_exec:s0
/vendor/bin/hardware_revisions\.sh                 u:object_r:hardware_rev_exec:s0
/vendor/bin/STFlashTool                             u:object_r:stflashtool_exec:s0
/vendor/bin/mbm_spy                                 u:object_r:mbm_spy_exec:s0
/vendor/bin/hw/motorola\.hardware\.lpsensing-service u:object_r:hal_sensors_default_exec:s0
/vendor/bin/hw/vendor\.dolby\.dms\.service          u:object_r:hal_aidl_dms_default_exec:s0

# Camera post-processing libraries are loaded by Motorola Camera (priv_app).
# Stock labels these same-process libraries so appdomain can map/read them.
/vendor/lib(64)?/libmpbase\.so                       u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libQnnHtp\.so                      u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libpostprocclient\.moto\.so        u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libportrait_repair_qnn\.so        u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarcsoft_tfs_hdr\.so            u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libenginepostproc\.moto\.so       u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarc\.ion\.so                   u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarcsoft_qnnhtp\.so             u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarcsoft_tfs_sr\.so             u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarcsoft_tfs_motioncapture\.so  u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarcsoft_tfs(_portrait)?_sn\.so u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarcsoft_tfs(_portrait)?_hdr\.so u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarcsoft_distortion_correction\.so u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarcsoft_portrait_distortion_correction\.so u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libarcsoft_tf_portrait_distortion_correction\.so u:object_r:same_process_hal_file:s0

# Keep the capsensor control nodes out of generic sysfs, as on stock.
/sys/class/capsense(/.*)?                           u:object_r:sysfs_capsense:s0
/sys/devices/virtual/capsense/capsense[01](/.*)?    u:object_r:sysfs_capsense:s0

/data/vendor/hardware_revisions(/.*)?               u:object_r:hwrev_data_file:s0
/data/vendor/dolby(/.*)?                            u:object_r:vendor_dolby_file:s0

# These names are stable /dev/block symlinks on RoadSTR.  The block-permission
# helper adjusts ownership and modes during early vendor initialization.
/dev/block/bootdevice/by-name/cid                    u:object_r:cid_block_device:s0
/dev/block/bootdevice/by-name/kpan                   u:object_r:kpan_block_device:s0
/dev/block/bootdevice/by-name/clogo                  u:object_r:clogo_block_device:s0
/dev/block/bootdevice/by-name/utags(Backup)?         u:object_r:vendor_utags_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/cid   u:object_r:cid_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/kpan  u:object_r:kpan_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/utags(Backup)? u:object_r:vendor_utags_block_device:s0
