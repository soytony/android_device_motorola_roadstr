# RoadSTR nodes absent from common Qualcomm/Motorola policy. Label exact paths
# so vendor services never need access to generic sysfs.
genfscon sysfs /bus/i2c/drivers u:object_r:sysfs_roadstr_bus_drivers:s0
genfscon sysfs /bus/spi/drivers u:object_r:sysfs_roadstr_bus_drivers:s0
genfscon sysfs /devices/platform/soc/ae00000.qcom,mdss_mdp/drm/card0/card0-DSI-1/dpms u:object_r:sysfs_roadstr_display_dpms:s0
genfscon sysfs /devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:qcom,battery_charger/wireless_fw_update u:object_r:sysfs_roadstr_wireless_fw:s0
genfscon sysfs /devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:qcom,battery_charger/wireless_fw_update_time_ms u:object_r:sysfs_roadstr_wireless_fw:s0
genfscon sysfs /devices/platform/soc/soc:qcom,pmic_glink_log/soc:qcom,pmic_glink_log:qcom,bm_adsp_ulog/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/wakeup u:object_r:sysfs_wakeup:s0
# Fingerprint driver exports standard wakeup statistics under a device-specific
# path. Label the subtree so system_suspend gets its existing read-only access.
genfscon sysfs /devices/platform/soc/soc:jiiov_fp/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /class/qcom-battery/wireless_fw_update u:object_r:sysfs_roadstr_wireless_fw:s0
genfscon sysfs /class/qcom-battery/wireless_fw_update_time_ms u:object_r:sysfs_roadstr_wireless_fw:s0
