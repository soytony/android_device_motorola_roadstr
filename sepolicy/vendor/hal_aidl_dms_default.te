# Dolby DMS ships as a vendor AIDL HAL. Keep it out of init's domain and scope
# its writable access to Dolby's own data directory.
type hal_aidl_dms_default, domain;
type hal_aidl_dms_default_exec, exec_type, vendor_file_type, file_type;
type hal_aidl_dms_service, protected_service, hal_service_type, service_manager_type;
type vendor_dolby_file, file_type, data_file_type;

init_daemon_domain(hal_aidl_dms_default)
binder_use(hal_aidl_dms_default)
add_service(hal_aidl_dms_default, hal_aidl_dms_service)

binder_call(hal_audio_default, hal_aidl_dms_default)
binder_call(hal_aidl_dms_default, hal_audio_default)

allow hal_audio_default hal_aidl_dms_service:service_manager find;
allow hal_aidl_dms_default vendor_dolby_file:dir create_dir_perms;
allow hal_aidl_dms_default vendor_dolby_file:file create_file_perms;

# DMS reads vendor audio tuning properties while initializing Dolby profiles.
# Read-only property access keeps property ownership with the audio stack.
get_prop(hal_aidl_dms_default, vendor_audio_prop)
