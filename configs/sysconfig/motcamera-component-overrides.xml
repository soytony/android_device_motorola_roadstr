<config>
    <!-- RoadSTR has no cover display. The CLI launch alias duplicates the normal
         Motorola capture intents even when CliCameraActivity is disabled. Keep
         normal and secure main-display camera entry points unchanged. -->
    <component-override package="com.motorola.camera5">
        <component class="com.motorola.camera.LaunchActionCli" enabled="false" />
    </component-override>
</config>
