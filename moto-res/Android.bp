// SPDX-License-Identifier: Apache-2.0

android_app {
    name: "moto-res",
    manifest: "AndroidManifest.xml",
    resource_dirs: ["res"],
    certificate: "platform",
    sdk_version: "system_current",

    // This is a base resource package, while per-device calibration remains
    // in the product RRO targeting it.
    install_in_system_framework: true,
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },
}
