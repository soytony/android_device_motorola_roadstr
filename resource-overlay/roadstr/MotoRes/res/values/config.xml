        <item>27</item>
        <item>49</item>
        <item>94</item>
        <item>170</item>
        <item>320</item>
        <item>440</item>
        <!-- Worst-case light-theme reference surface measured at 741 nits. -->
        <item>621</item>
    </integer-array>
