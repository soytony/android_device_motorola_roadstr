<resources>
    <string name="config_motoRearLightSensorType" translatable="false">com.motorola.sensor.alternate_light</string>
    <string name="config_motoRearLightSampleMaxAgeMs" translatable="false">2000</string>
    <string name="config_motoAmbientLuxFrontSampleResetGapMs" translatable="false">2000</string>
    <!-- Bound the light-theme correction in sensor-equivalent lux. This is deliberately
         finite: it must remove panel leakage without allowing a malformed target to erase
         genuine outdoor ambient light. -->
    <string name="config_motoAmbientLuxMaxLeakageLux" translatable="false">1600</string>
    <!-- The table already records sensor-equivalent leakage for the reference light surface.
         A global light-theme multiplier also subtracts genuine front illumination when it is
         comparable to panel leakage, creating an auto-brightness oscillation. Content-specific
         residual correction must use the separately bounded rear/ROI paths. -->
    <string name="config_motoAmbientLuxLightThemeLeakageScale" translatable="false">1.0</string>
    <string name="config_motoAmbientLuxRearLowLux" translatable="false">10</string>
    <!-- Delay is panel emission plus ALS integration time; noise values are lux squared. -->
    <string name="config_motoAmbientLuxPostureSampleMaxAgeMs" translatable="false">1500</string>
    <string name="config_motoAmbientLuxTargetHistoryMaxAgeMs" translatable="false">8000</string>
    <string name="config_motoAmbientLuxTargetHistoryMaxSize" translatable="false">64</string>
    <string name="config_motoAmbientLuxDisplayToAlsDelayMs" translatable="false">150</string>
    <!-- Keep the prior high-panel leakage estimate while the panel and UDALS settle after dimming. -->
    <string name="config_motoAmbientLuxLeakageHoldAfterTargetDropMs" translatable="false">2000</string>
    <string name="config_motoAmbientLuxTargetTransitionPenaltyMs" translatable="false">1000</string>
    <string name="config_motoAmbientLuxFrontMeasurementVariance" translatable="false">25</string>
    <string name="config_motoAmbientLuxRearMeasurementVariance" translatable="false">25</string>
    <string name="config_motoAmbientLuxTargetTransitionVariance" translatable="false">900</string>
    <string name="config_motoAmbientLuxFrontProcessNoise" translatable="false">80</string>
    <string name="config_motoAmbientLuxRearProcessNoise" translatable="false">80</string>
    <!-- Positive Z means display-up/rear-down for this Android sensor coordinate system. -->
    <string name="config_motoAmbientLuxRearDownGravityZ" translatable="false">8.5</string>
    <string name="config_motoAmbientLuxStationaryMotionVariance" translatable="false">0.08</string>
    <string name="config_motoAmbientLuxRearOcclusionDwellMs" translatable="false">3000</string>
    <string name="config_motoAmbientLuxFusionGateSigma" translatable="false">3</string>
    <string name="config_motoAmbientLuxRearAssistAbsoluteMarginLux" translatable="false">30</string>
    <!-- Rear ALS is only an upward hint; require stable, high-confidence evidence. -->
    <string name="config_motoAmbientLuxRearAssistRelativeMargin" translatable="false">0.35</string>
    <!-- Never let a near-dark rear zero-point reading raise the primary ALS result. -->
    <string name="config_motoAmbientLuxRearAssistMinimumLux" translatable="false">20</string>
    <string name="config_motoAmbientLuxRearAssistConfirmDwellMs" translatable="false">1200</string>
    <string name="config_motoAmbientLuxRearAssistMinimumConfidence" translatable="false">0.85</string>
    <!-- Rear ALS is an auxiliary upward reference; bound its influence explicitly. -->
    <string name="config_motoAmbientLuxRearAssistGain" translatable="false">0.08</string>
    <string name="config_motoAmbientLuxRearAssistMaxDeltaLux" translatable="false">200</string>
    <string name="config_motoAmbientLuxRearAssistMaxRelativeDelta" translatable="false">0.15</string>
    <string name="config_motoAmbientLuxRearAssistMaxRiseLuxPerSecond" translatable="false">120</string>
    <string name="config_motoAmbientLuxRearAssistMaxFallLuxPerSecond" translatable="false">300</string>
    <!-- Lower the residual front-ALS leakage only after a credible, persistent rear-ALS check. -->
    <!-- Permit rear ALS to reject residual front leakage at low ambient lux. -->
    <string name="config_motoAmbientLuxRearConstraintAbsoluteMarginLux" translatable="false">15</string>
    <!-- Allow a credible dark rear ALS to remove residual UDALS leakage at moderate lux. -->
    <string name="config_motoAmbientLuxRearConstraintRelativeMargin" translatable="false">0.15</string>
    <string name="config_motoAmbientLuxRearConstraintMinimumLeakageLux" translatable="false">10</string>
    <!-- Only let a dark rear ALS constrain a small likely leakage residual, not front-side light. -->
    <string name="config_motoAmbientLuxRearConstraintMaximumFrontLeakageRatio" translatable="false">0.50</string>
    <string name="config_motoAmbientLuxRearConstraintMinimumConfidence" translatable="false">0.25</string>
    <string name="config_motoAmbientLuxRearConstraintConfirmDwellMs" translatable="false">750</string>
    <!-- Consume the bounded residual fully after the leakage case is confirmed. -->
    <string name="config_motoAmbientLuxRearConstraintGain" translatable="false">1.0</string>
    <!-- A confirmed rear-dark reading may remove the complete calibrated UDALS residual. -->
    <string name="config_motoAmbientLuxRearConstraintMaxDeltaLux" translatable="false">1200</string>
    <string name="config_motoAmbientLuxRearConstraintMaxRelativeDelta" translatable="false">1.0</string>
    <string name="config_motoAmbientLuxRearConstraintMaxFallLuxPerSecond" translatable="false">300</string>
    <bool name="config_motoAmbientLuxRoiEnabled">false</bool>
    <string name="config_motoAmbientLuxRoiSampleMaxAgeMs" translatable="false">500</string>
    <string name="config_motoAmbientLuxRoiLeakageScale" translatable="false">0</string>
    <string name="config_motoAmbientLuxRoiLeakageReferenceLuma" translatable="false">0.5</string>
    <string name="config_motoAmbientLuxRoiLeft" translatable="false">0</string>
    <string name="config_motoAmbientLuxRoiTop" translatable="false">0</string>
    <string name="config_motoAmbientLuxRoiRight" translatable="false">0</string>
    <string name="config_motoAmbientLuxRoiBottom" translatable="false">0</string>
    <!-- Measured in a dark enclosure against a fixed Settings surface. The front ALS leaks
         considerably more panel light in light theme, so the two curves stay independent. -->
    <integer-array name="config_motoAmbientLuxLeakageNits">
        <item>0</item>
        <item>65</item>
        <item>130</item>
        <item>257</item>
        <item>497</item>
        <item>669</item>
        <item>703</item>
        <item>740</item>
    </integer-array>
