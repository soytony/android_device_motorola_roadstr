<resources>
    <!-- Status bar clock size -->
    <dimen name="status_bar_clock_size">15.0sp</dimen>

    <!-- Padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">6dp</dimen>

    <!-- Padding on the top of the statusbar. Disabled as we use vertically
    symmetrical status bar around the camera hole -->
    <dimen name="status_bar_padding_top">0px</dimen>

    <!-- Height of the status bar header bar when on Keyguard -->
    <dimen name="status_bar_header_height_keyguard">@*android:dimen/status_bar_height</dimen>

    <dimen name="physical_power_button_center_screen_location_y">1100.0px</dimen>
    <dimen name="rounded_corner_content_padding">27.0px</dimen>

    <!-- Use tighter corners for the biometric prompt and its custom content. -->
    <dimen name="biometric_dialog_corner_size">20dp</dimen>
    <dimen name="biometric_prompt_content_corner_radius">20dp</dimen>

    <!-- Stock RoadSTR value used to size the physical UDFPS icon correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">38</item>

    <!-- Keep charging and trust indications below the UDFPS sensor bounds. -->
    <dimen name="keyguard_indication_margin_bottom">16dp</dimen>

    <!-- Margin on the left side of the carrier text on Keyguard -->
    <dimen name="keyguard_carrier_text_margin">@dimen/status_bar_padding_start</dimen>
    <!-- Min height of the QS header row, which contains the clock and date,
    when the QS is expanded. This is used to determine how much to scale the
    clock and date when the QS is expanded.
    the center of the camera hole is at y = 79 px
    120px + 2 * 19 px = 158px -->
    <dimen name="qs_header_row_min_height">158.0px</dimen>

</resources>
