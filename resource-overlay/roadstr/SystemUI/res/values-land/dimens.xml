<resources>
    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">8dp</dimen>

    <!-- Reserve room for the 6dp privacy dot without the default 20dp gap. -->
    <dimen name="ongoing_appops_dot_min_padding">12dp</dimen>

    <!-- the padding on the top of the statusbar -->
    <dimen name="status_bar_padding_top">0px</dimen>

    <!-- Height of the status bar header bar when on Keyguard -->
    <dimen name="status_bar_header_height_keyguard">40dp</dimen>

    <dimen name="rounded_corner_content_padding">40px</dimen>

    <!-- Margin on the left side of the carrier text on Keyguard -->
    <dimen name="keyguard_carrier_text_margin">16dp</dimen>

    <dimen name="qs_header_row_min_height">@*android:dimen/status_bar_height</dimen>

</resources>
