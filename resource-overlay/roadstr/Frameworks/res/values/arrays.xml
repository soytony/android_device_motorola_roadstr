<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string-array name="config_defaultPinnerServiceFiles">
        <item>/system/framework/arm64/boot-framework.oat</item>
        <item>/system/framework/arm64/boot.oat</item>
        <item>/system/framework/framework.jar</item>
        <item>/system/framework/services.jar</item>
        <item>/system/lib/libhwui.so</item>
        <item>/system/lib64/libaudioprocessing.so</item>
    </string-array>
    <string-array name="config_telephonyEuiccDeviceCapabilities">
        <item>gsm,9</item>
        <item>utran,9</item>
        <item>eutran,17</item>
        <item>nfc,17</item>
    </string-array>
    <string-array name="config_tether_usb_regexs">
        <item>rndis\\d</item>
    </string-array>
    <integer-array name="config_udfps_sensor_props">
        <item>610</item>
        <item>2440</item>
        <item>102</item>
    </integer-array>

    <!--
         The shared panel curve was dim in normal indoor use. These sixteen values map to
         the sixteen lux zones defined by the inherited config_autoBrightnessLevels array.
         Lift 2-1250 lux; retain stock high-light and HBM behavior for readability,
         panel safety, and a predictable first calibration pass.
    -->
    <integer-array name="config_autoBrightnessDisplayValuesNits">
        <item>3</item>
        <item>15</item>
        <item>30</item>
        <item>58</item>
        <item>105</item>
        <item>165</item>
        <item>250</item>
        <item>270</item>
        <item>270</item>
        <item>412</item>
        <item>500</item>
        <item>700</item>
        <item>800</item>
        <item>1000</item>
        <item>1500</item>
        <item>1850</item>
    </integer-array>

    <!-- Near-dark, fixed-Settings-surface calibration. The front ALS sees substantially
         more panel light in light theme; the framework interpolates these values by target nits. -->
    <integer-array name="config_ambientLightFusionLeakageNits">
        <item>0</item>
        <item>65</item>
        <item>130</item>
        <item>257</item>
        <item>497</item>
        <item>669</item>
        <item>703</item>
        <item>740</item>
    </integer-array>
    <integer-array name="config_ambientLightFusionLightThemeLeakageLux">
        <item>0</item>
        <item>10</item>
        <item>30</item>
        <item>65</item>
        <item>120</item>
        <item>200</item>
        <item>340</item>
        <item>460</item>
    </integer-array>
    <integer-array name="config_ambientLightFusionDarkThemeLeakageLux">
        <item>0</item>
        <item>0</item>
        <item>0</item>
        <item>0</item>
        <item>1</item>
        <item>3</item>
        <item>5</item>
        <item>7</item>
    </integer-array>

    <!-- Vibrator pattern for feedback about a long screen/key press -->
    <integer-array name="config_longPressVibePattern">
        <item>0</item>
        <item>30</item>
    </integer-array>

    <!-- Vibrator pattern for feedback about touching a virtual key -->
    <integer-array name="config_virtualKeyVibePattern">
        <item>0</item>
        <item>20</item>
    </integer-array>

    <!-- Compress a wide ambient CCT range into a restrained panel range for
         the first adaptive white-balance validation. -->
    <integer-array name="config_displayWhiteBalanceAmbientColorTemperatures">
        <item>2500</item>
        <item>3500</item>
        <item>4500</item>
        <item>5500</item>
        <item>6500</item>
        <item>8000</item>
        <item>10000</item>
    </integer-array>
    <integer-array name="config_displayWhiteBalanceDisplayColorTemperatures">
        <item>4500</item>
        <item>5000</item>
        <item>5600</item>
        <item>6350</item>
        <item>6500</item>
        <item>7000</item>
        <item>7500</item>
    </integer-array>

    <!-- Ignore ambient CCT changes below five percent to avoid oscillation. -->
    <array name="config_displayWhiteBalanceBaseThresholds">
        <item>0</item>
    </array>
    <array name="config_displayWhiteBalanceIncreaseThresholds">
        <item>0.05</item>
    </array>
    <array name="config_displayWhiteBalanceDecreaseThresholds">
        <item>0.05</item>
    </array>

</resources>
