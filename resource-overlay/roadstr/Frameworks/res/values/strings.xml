<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="config_clockFontFamily">moto_time</string>
    <string name="config_dozeComponent">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <!-- Sysfs-backed one-shot sensor provided by sensors.moto_ext. -->
    <string name="config_dozeDoubleTapSensorType">org.lineageos.sensor.double_tap</string>
    <!-- Physical front-camera hole: display center X, center Y 79 px, radius 33 px. -->
    <string name="config_mainBuiltInDisplayCutout">M 33,79 A 33,33 0 0 1 0,111 A 33,33 0 0 1 -33,79 A 33,33 0 0 1 0,47 A 33,33 0 0 1 33,79 Z</string>
    <!-- Keep the larger logical exclusion area used to align status-bar content. -->
    <string name="config_mainBuiltInDisplayCutoutRectApproximation">M -56,0 L 56,0 L 56,158 L -56,158 Z</string>
    <string name="config_mms_user_agent">motorolaedge70</string>
    <string name="config_mms_user_agent_profile_url">http://uaprof.motorola.com/phoneconfig/motov1/Profile/motov1.rdf</string>
    <!-- The ALS is exposed by the vendor sensors HAL.  Framework auto
         brightness was enabled without a brightness curve, so it had no
         usable mapping from lux to panel luminance. -->
    <string name="config_displayLightSensorType">android.sensor.light</string>
    <!-- Invoke Motorola's stock vendor ALS compensation service. Its identifiers are supplied
         by the com.motorola.res MotoRes RRO, not encoded in this class declaration. -->
    <string name="config_ambientLuxProcessorClass" translatable="false">com.motorola.display.StockAlsCompensationProcessor</string>
    <!-- String type published by the rear STK6B9X RGB/CCT sensor. -->
    <string name="config_displayWhiteBalanceColorTemperatureSensorName"
            translatable="false">com.motorola.sensor.alternate_rgb</string>
    <!-- Keep generic provider discovery disabled; values-mcc460 selects Baidu. -->
    <string name="config_networkLocationProviderPackageName" translatable="false">com.qualcomm.location</string>

    <!-- Use a compact separator between multiple SIM carrier names on keyguard. -->
    <string name="kg_text_message_separator" translatable="false"> | </string>

</resources>
