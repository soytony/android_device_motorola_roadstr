<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="config_clockFontFamily">moto_time</string>
    <string name="config_dozeComponent">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <!-- Sensor type published by the stock Motorola sensors HAL. -->
    <string name="config_dozeDoubleTapSensorType">com.motorola.sensor.double_tap</string>
    <string name="config_mainBuiltInDisplayCutout">M -56,0 L 56,0 L 56,125 L -56,125 Z</string>
    <string name="config_mms_user_agent">motorolaedge70</string>
    <string name="config_mms_user_agent_profile_url">http://uaprof.motorola.com/phoneconfig/motov1/Profile/motov1.rdf</string>
    <!-- The ALS is exposed by the vendor sensors HAL.  Framework auto
         brightness was enabled without a brightness curve, so it had no
         usable mapping from lux to panel luminance. -->
    <string name="config_displayLightSensorType">android.sensor.light</string>
    <!-- String type published by the rear STK6B9X RGB/CCT sensor. -->
    <string name="config_displayWhiteBalanceColorTemperatureSensorName"
            translatable="false">com.motorola.sensor.alternate_rgb</string>

</resources>
